default_platform(:ios)

platform :ios do
  desc "Build and upload Car Parking Jam 3D to Apple App Store Connect"
  lane :release do
    sh("flutter", "build", "ipa", "--release")
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end

